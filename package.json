{
  "name": "fcp-sfd-comms-publisher-stub",
  "version": "0.0.0",
  "description": "fcp-sfd-comms-publisher-stub",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development npm run server:watch",
    "dev:debug": "NODE_ENV=development npm run server:debug",
    "docker:build": "docker compose build",
    "docker:dev": "docker compose up",
    "git:pre-commit-hook": "npm run lint:fix",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "postinstall": "npm run setup:husky",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js,json --legacy-watch ./src",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js,json --legacy-watch ./src",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "start": "NODE_ENV=production node --use-strict .",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest",
    "docker:test": "npm run lint && mkdir -p -m 755 coverage 2>/dev/null || true && docker compose -p fcp-sfd-comms-publisher-stub-test down -v && docker compose -f compose.yml -f compose.test.yml -p fcp-sfd-comms-publisher-stub-test run --build --rm fcp-sfd-comms-publisher-stub",
    "docker:test:watch": "docker compose -p fcp-sfd-comms-publisher-stub-test down -v && docker compose -f compose.yml -f compose.test.yml -f compose.test.watch.yml -p fcp-sfd-comms-publisher-stub-test run --build --rm fcp-sfd-comms-publisher-stub",
    "sonar": "node scripts/sonar-scan.js"
  },
  "author": "Defra DDTS",
  "contributors": [
    "Rana Salem <rana.salem@defra.go.uk>"
  ],
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/client-sns": "3.1075.0",
    "@aws-sdk/client-sqs": "3.1075.0",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "7.1.2",
    "@hapi/vision": "7.0.3",
    "aws-embedded-metrics": "4.2.1",
    "aws4": "1.13.2",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "global-agent": "4.1.3",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "hapi-swagger": "17.3.2",
    "joi": "18.2.3",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "sqs-consumer": "15.0.2",
    "undici": "8.5.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.29.0",
    "husky": "9.1.7",
    "neostandard": "0.13.0",
    "nodemon": "3.1.14",
    "vitest": "4.1.9"
  },
  "overrides": {
    "hapi-swagger": {
      "joi": "18.2.3"
    }
  }
}
